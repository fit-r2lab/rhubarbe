# this is meant to be installed under /etc/systemd/system
[Unit]
Description=runs a HTTP API to read Rhubarbe relay temperatures

[Service]
#Environment="PYTHONASYNCIODEBUG=1"
WorkingDirectory=/opt/rhubarbe
ExecStart=/root/.local/bin/uv run --frozen rhubarbe-relaysapi
Restart=always
RestartSec=60s

[Install]
WantedBy=multi-user.target
